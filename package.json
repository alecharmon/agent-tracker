{
  "name": "agent-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "cli",
    "worker",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev -w @agent-tracker/worker",
    "build": "npm run build -w @agent-tracker/web",
    "test": "npm test -w @agent-tracker/core && npm test -w @agent-tracker/cli && node --test --no-warnings evals/*.test.ts",
    "seed": "node --no-warnings cli/src/main.ts seed",
    "setup:access": "node scripts/setup-access.mjs",
    "evals": "node --no-warnings evals/run.ts",
    "deploy": "node scripts/deploy.mjs"
  }
}
