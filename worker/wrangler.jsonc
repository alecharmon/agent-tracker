{
  // Pinned to the captain's personal Cloudflare account (the captain's): deploys can't land
  // in another account whatever wrangler is logged in as. No deploys until the captain says so.
  "name": "agent-tracker",
  "account_id": "<cloudflare account id>",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/authorize", "/register", "/login", "/login/*", "/logout", "/oauth/*", "/.well-known/*"]
  },
  "durable_objects": { "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
  // OAuth grants and tokens (workers-oauth-provider); wrangler dev simulates it locally.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<kv namespace id>" }],
  // Canonical origin: OAuth issuer and resource base. Set per deployment.
  // (worker/.dev.vars overrides it for local dev.)
  "vars": { "TRACKER_URL": "https://agent-tracker.<you>.workers.dev" }
  // Secrets: SESSION_SECRET, TRACKER_ALLOW (JSON allowlist), ACCESS_CLIENT_ID/SECRET, ACCESS_AUTHORIZATION_URL,
  // ACCESS_TOKEN_URL, ACCESS_JWKS_URL. See docs/auth.md; `npm run setup:access` prints them.
}
