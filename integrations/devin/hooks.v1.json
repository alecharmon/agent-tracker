{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "agents hook devin session-start",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "agents hook devin prompt",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "agents hook devin stop",
          "timeout": 3600,
          "statusMessage": "Waiting for the captain's answer on the agent tracker"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "agents hook devin session-end",
          "timeout": 5
        }
      ]
    }
  ]
}
